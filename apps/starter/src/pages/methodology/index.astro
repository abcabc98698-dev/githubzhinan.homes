---
import StarterLayout from '@/layouts/StarterLayout.astro';
import Navbar from '@astro-v7/shared/components/Navbar.astro';
import ThemeToggle from '@astro-v7/shared/components/ThemeToggle.svelte';
import { env } from '@/env';
import '@/styles/app.css';

const pageTitle = '网络可观测性评测方法论与遥测基准规范 - GitHub指南';
const pageDescription = 'GitHub指南网络可观测性实验室评测方法论白皮书：涵盖往返延迟 (RTT)、晚高峰带宽吞吐、丢包率抖动、原生住宅 IP 纯净度检测及防跑路预警模型的具体评测标准。';

const links = [
  { href: '/', label: '首页' },
  { href: '/brands/guangsu/', label: '光速云 (TOP 1)' },
  { href: '/radar/', label: '🚨 跑路雷达' },
  { href: '/observatory/', label: '⚡ 测速室' },
  { href: '/clients/', label: '💻 客户端' },
  { href: '/faq/', label: '📖 疑难百科' },
  { href: '/free/', label: '🎁 免费资源' },
  { href: '/brands/', label: '42家品牌库' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': 'https://githubzhinan.homes/methodology/#webpage',
      'url': 'https://githubzhinan.homes/methodology/',
      'name': pageTitle,
      'description': pageDescription,
      'isPartOf': { '@id': 'https://githubzhinan.homes/#website' },
      'inLanguage': 'zh-CN',
      'datePublished': '2026-10-19',
      'dateModified': '2026-10-31',
    }
  ]
};
---

<StarterLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <Navbar
    slot="header"
    siteName={env.PUBLIC_SITE_NAME || 'GitHub指南'}
    homeUrl="/"
    links={links}
    currentPath="/methodology/"
  >
    <ThemeToggle client:load />
  </Navbar>

  <div class="min-h-screen bg-bg text-text py-12 px-4 sm:px-6">
    <article class="mx-auto max-w-4xl">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-text-secondary font-mono">
        <a href="/" class="hover:text-text no-underline">首页</a>
        <span>/</span>
        <span class="text-text font-semibold">评测方法论</span>
      </nav>

      <!-- Header -->
      <header class="border-b border-border pb-8 mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-mono font-semibold mb-4 border border-blue-500/20">
          <span>BENCHMARK METHODOLOGY & TELEMETRY STANDARDS</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-text mb-4">
          网络可观测性评测方法论与遥测基准规范
        </h1>
        <p class="text-text-secondary text-base sm:text-lg leading-relaxed">
          公开实验室的测试硬件平台、探针拓扑架构、晚高峰抽样算法与风险预警评估模型，确保每一项延迟与带宽数据具备高度可重复性与可信度。
        </p>
      </header>

      <!-- Section 1: Testing Rig -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4 flex items-center gap-2">
          <span class="text-emerald-500">01.</span>
          <span>测试基准环境与探针硬件配置</span>
        </h2>
        <div class="prose prose-neutral dark:prose-invert max-w-none text-text-secondary text-sm leading-relaxed space-y-4">
          <p>
            为杜绝客户端本地算力不足或家用 Wi-Fi 抖动带来的误差，实验室所有测速均运行于标准化测试探针：
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong>接入网络</strong>：千兆独享光纤接入（中国电信 / 中国联通 / 中国移动双线 BGP 核心机房，直连骨干网 163 / 9929 / CMNET）。</li>
            <li><strong>系统环境</strong>：Ubuntu 24.04 LTS x86_64，内核启用 BBRv3 拥塞控制算法。</li>
            <li><strong>代理内核</strong>：开源现代内核 Mihomo (Clash Meta) 与 Sing-box 官方最新稳定版，配置开启纯 TUN 模式与 Fake-IP DNS 引擎。</li>
            <li><strong>物理网卡</strong>：Intel X520 10GbE 物理直通网卡，消除 CPU 软中断瓶颈。</li>
          </ul>
        </div>
      </section>

      <!-- Section 2: Peak Hour Sampling -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4 flex items-center gap-2">
          <span class="text-emerald-500">02.</span>
          <span>晚高峰抽样与核心物理指标定义</span>
        </h2>
        <p class="text-text-secondary text-sm leading-relaxed mb-4">
          代理服务在凌晨空闲时段测速无任何参考价值。本实验室重点采集<strong>每天 20:00 - 23:30（国际出口拥堵最严重的晚高峰时段）</strong>的指标：
        </p>
        <div class="overflow-x-auto rounded-xl border border-border bg-surface mb-6">
          <table aria-label="核心评测维度与权重分配表" class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-border bg-bg-secondary/60 text-text font-mono">
                <th class="p-3.5">评测指标</th>
                <th class="p-3.5">测量工具与协议</th>
                <th class="p-3.5">优秀基准</th>
                <th class="p-3.5">技术判据与风控意义</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/60 font-mono text-text-secondary">
              <tr>
                <td class="p-3.5 font-bold text-text">RTT 往返延迟</td>
                <td class="p-3.5">TCPing / ICMP 100 次抽样</td>
                <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-bold">&lt; 35 ms (港台)</td>
                <td class="p-3.5">反映物理路由是否为内网专线（IEPL/IPLC）或公网绕路。</td>
              </tr>
              <tr>
                <td class="p-3.5 font-bold text-text">晚高峰丢包率</td>
                <td class="p-3.5">持续 30 分钟连续探测</td>
                <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-bold">0.0% ~ 0.5%</td>
                <td class="p-3.5">公网中转晚高峰常出现 10%~30% 丢包，物理专线保持零丢包。</td>
              </tr>
              <tr>
                <td class="p-3.5 font-bold text-text">单线程下行带宽</td>
                <td class="p-3.5">Speedtest-CLI / 自建 Nginx</td>
                <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-bold">&gt; 300 Mbps</td>
                <td class="p-3.5">考验入口与落地带宽冗余度，直接决定 4K 60FPS 流媒体能否秒开。</td>
              </tr>
              <tr>
                <td class="p-3.5 font-bold text-text">延迟抖动 (Jitter)</td>
                <td class="p-3.5">标准差方差算法计算</td>
                <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-bold">&lt; 3.0 ms</td>
                <td class="p-3.5">抖动过大会造成实时语音会议、远程 SSH 终端卡顿断连。</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: AI and Streaming -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4 flex items-center gap-2">
          <span class="text-emerald-500">03.</span>
          <span>AI 与流媒体可用性检测标准</span>
        </h2>
        <div class="prose prose-neutral dark:prose-invert max-w-none text-text-secondary text-sm leading-relaxed space-y-4">
          <p>
            现代网络代理的核心用途已转向海外 AI（ChatGPT、Claude 3.5 Sonnet、Google Gemini）与流媒体服务。实验室采用自动化探针针对各落地 IP 进行实时风控画像检测：
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong>IPQS 欺诈评分</strong>：IPQualityScore 欺诈分值低于 25 分为安全原生住宅/企业 IP，高于 75 分标记为高风险机房 IP。</li>
            <li><strong>OpenAI / Anthropic 原生落地校验</strong>：模拟 TLS 1.3 ClientHello 握手与 HTTP POST 交互，检测是否触发 Cloudflare Turnstile 验证码死循环或 1020 封锁。</li>
            <li><strong>Netflix / Disney+ 区域原创剧解锁</strong>：检测是否能获取当前地区版权库的独占内容（非自制剧），杜绝仅能看自制剧的伪解锁。</li>
          </ul>
        </div>
      </section>

      <!-- Section 4: Radar Warning Model -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4 flex items-center gap-2">
          <span class="text-emerald-500">04.</span>
          <span>跑路预警雷达评分模型</span>
        </h2>
        <div class="p-5 rounded-2xl border border-amber-500/30 bg-amber-500/5 text-sm text-text-secondary leading-relaxed space-y-3">
          <p>
            实验室依托对近 5 年倒闭跑路的 50+ 机场样本分析，建立了多因子综合跑路预警模型：
          </p>
          <p class="font-mono text-xs">
            <strong>跑路风险指数 (RRI) = 0.35 × 定价倒挂系数 + 0.25 × 线路透明度缺失 + 0.20 × 社区禁言状态 + 0.20 × 存活周期倒数</strong>
          </p>
          <p>
            当服务商出现“大额终身套餐”、“群组全员禁言超过 72 小时”、“全节点协议改为明文 HTTP 中转”等严重特征时，模型将自动将其判定为 <code>CRITICAL (高危预警)</code> 并录入 <a href="/radar/" class="text-emerald-600 dark:text-emerald-400 font-bold underline">跑路预警雷达黑名单</a>。
          </p>
        </div>
      </section>
    </article>
  </div>
</StarterLayout>
