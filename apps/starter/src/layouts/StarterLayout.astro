---
import type { Props as BaseLayoutProps } from '@astro-v7/shared/layouts/BaseLayout.astro';
import BaseLayout from '@astro-v7/shared/layouts/BaseLayout.astro';
import { WebVitals } from '@casoon/astro-webvitals';

export interface Props extends BaseLayoutProps {
  structuredData?: Record<string, any>;
}

const { structuredData } = Astro.props;

// Search Console & Webmaster Verification Meta Tags
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const baiduVerification = import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION;
const shenmaVerification = import.meta.env.PUBLIC_SHENMA_SITE_VERIFICATION;
---

<BaseLayout {...Astro.props}>
  <slot name="head" slot="head" />
  {googleVerification && <meta name="google-site-verification" content={googleVerification} slot="head" />}
  {bingVerification && <meta name="msvalidate.01" content={bingVerification} slot="head" />}
  {baiduVerification && <meta name="baidu-site-verification" content={baiduVerification} slot="head" />}
  {shenmaVerification && <meta name="shenma-site-verification" content={shenmaVerification} slot="head" />}
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} slot="head" />
  )}
  <script is:inline src="/site.js" slot="head"></script>
  <slot name="header" slot="header" />
  <slot />
  <footer slot="footer" class="border-t border-border bg-surface py-12 text-xs text-text-secondary font-mono">
    <div class="mx-auto max-w-6xl px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-2">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span class="font-bold text-text text-sm">GitHub指南 (githubzhinan.homes)</span>
        <span class="hidden sm:inline">· 2026 网络可观测性与出海基建实验室</span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs">
        <a href="/" class="hover:text-text no-underline">首页</a>
        <a href="/vpn/" class="hover:text-text no-underline">VPN推荐</a>
        <a href="/jichang/" class="hover:text-text no-underline">机场推荐</a>
        <a href="/clash/" class="hover:text-text no-underline">Clash教程</a>
        <a href="/nodes/" class="hover:text-text no-underline">节点测速</a>
        <a href="/tizi/" class="hover:text-text no-underline">梯子避坑</a>
        <a href="/free/" class="hover:text-text no-underline">免费资源</a>
        <a href="/tutorial/" class="hover:text-text no-underline">使用教程</a>
        <a href="/brands/" class="hover:text-text no-underline">品牌库</a>
        <a href="/brands/guangsu/" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline no-underline">光速云 (TOP 1)</a>
        <a href="/radar/" class="hover:text-text no-underline">跑路雷达</a>
        <a href="/faq/" class="hover:text-text no-underline">疑难百科</a>
        <a href="/observatory/" class="hover:text-text no-underline">测速大盘</a>
        <a href="/about/" class="hover:text-text no-underline font-semibold">关于实验室</a>
        <a href="/methodology/" class="hover:text-text no-underline font-semibold">评测方法论</a>
        <a href="/privacy/" class="hover:text-text no-underline">隐私政策</a>
        <a href="/terms/" class="hover:text-text no-underline">服务条款</a>
      </div>
    </div>
    <div class="mx-auto max-w-6xl px-6 mt-4 pt-4 border-t border-border/40 text-center text-[11px] text-text-secondary/70">
      数据基于独立探针客观记录 · 遵循 rel="nofollow sponsored noopener" 规范 · 仅用于合法学术科研与跨境软件开发
    </div>
  </footer>
  <WebVitals
    debug={import.meta.env.DEV}
    endpoint="/api/analytics/vitals/"
    sampleRate={import.meta.env.DEV ? 1 : 0.1}
    dashboard
  />
</BaseLayout>
