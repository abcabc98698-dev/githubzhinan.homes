---
import { getLocaleFromPath, localePath } from '../utils/i18n';

export interface NavLink {
  href: string;
  label: string;
}

export interface Props {
  siteName: string;
  links?: NavLink[];
}

const { siteName, links = [] } = Astro.props;
const currentPath = Astro.url.pathname;
const homeHref = localePath('/', getLocaleFromPath(currentPath));

function normalizePath(path: string): string {
  if (path === '/') return '/';
  return path.endsWith('/') ? path.slice(0, -1) : path;
}
---

<header class="sticky top-0 z-[var(--z-sticky)] min-h-[var(--nav-height)] border-b border-border bg-[var(--color-surface)] backdrop-blur-[12px]">
<nav aria-label="Main navigation" class="h-full">
  <div class="mx-auto flex min-h-[var(--nav-height)] max-w-[72rem] items-center justify-between px-[var(--space-lg)] gap-4 flex-wrap md:flex-nowrap py-2 md:py-0">
    <div class="flex items-center gap-4">
      <a href={homeHref} class="flex items-center gap-2 text-lg font-bold text-text no-underline tracking-tight">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{siteName}</span>
      </a>
    </div>

    {links.length > 0 && (
      <ul class="flex items-center gap-1 sm:gap-2 list-none p-0 m-0 overflow-x-auto no-scrollbar order-3 md:order-2 w-full md:w-auto pb-1 md:pb-0" role="list">
        {links.map((link) => {
          const isCurrent = normalizePath(currentPath) === normalizePath(link.href);
          const isGuangsu = link.href.includes('guangsu');
          return (
            <li class="shrink-0">
              <a
                href={link.href}
                class:list={[
                  'text-xs sm:text-sm font-medium no-underline px-2.5 py-1.5 rounded-[var(--radius-lg)] transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] whitespace-nowrap',
                  isCurrent
                    ? 'text-text bg-bg-secondary shadow-sm font-semibold'
                    : 'text-text-secondary hover:text-text hover:bg-bg-secondary',
                  isGuangsu && !isCurrent ? 'text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-500/10' : ''
                ]}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <div class="flex items-center gap-[var(--space-sm)] order-2 md:order-3">
      <slot />
    </div>
  </div>
</nav>
</header>
