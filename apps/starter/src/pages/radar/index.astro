---
import StarterLayout from '@/layouts/StarterLayout.astro';
import Navbar from '@astro-v7/shared/components/Navbar.astro';
import ThemeToggle from '@astro-v7/shared/components/ThemeToggle.svelte';
import { env } from '@/env';
import { BRANDS, getFeaturedBrand } from '@astro-v7/shared/data/brands';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import '@/styles/app.css';

const featuredBrand = getFeaturedBrand(); // 光速云

const pageTitle = '机场跑路预警雷达：2026最新跑路黑名单与避坑防雷白皮书 - GitHub指南';
const pageDescription = '2026跨境网络服务风险雷达：实时追踪跑路倒闭机场名单，深度复盘知名机场死因。解密超卖庞氏模型与大额促销跑路前兆，提供42家品牌存活年限审计与维权止损SOP。认准6年长青老牌，远离资金盘风险。';

const links = [
  { href: '/', label: '首页' },
  { href: '/brands/guangsu/', label: '光速云 (TOP 1)' },
  { href: '/radar/', label: '🚨 跑路雷达' },
  { href: '/observatory/', label: '⚡ 测速室' },
  { href: '/clients/', label: '💻 客户端' },
  { href: '/faq/', label: '📖 疑难百科' },
  { href: '/free/', label: '🎁 免费资源' },
  { href: '/brands/', label: '42家品牌库' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://githubzhinan.homes/radar/#webpage',
      'url': 'https://githubzhinan.homes/radar/',
      'name': pageTitle,
      'description': pageDescription,
      'isPartOf': { '@id': 'https://githubzhinan.homes/#website' },
      'datePublished': '2026-10-19',
      'dateModified': '2026-10-31'
    },
    {
      '@type': 'ItemList',
      '@id': 'https://githubzhinan.homes/radar/#risk-signs',
      'name': '机场跑路前兆 8 大高危特征雷达',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': '突发 3-5 年大额超低折扣促销（资金盘最后的收割）',
          'url': 'https://githubzhinan.homes/radar/#eight-warning-signs'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': '官方 Telegram 频道禁言、关闭评论区',
          'url': 'https://githubzhinan.homes/radar/#eight-warning-signs'
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': '客服工单已读不回、响应时间超过 72 小时',
          'url': 'https://githubzhinan.homes/radar/#eight-warning-signs'
        },
        {
          '@type': 'ListItem',
          'position': 4,
          'name': '主要节点连续断联数天，借口总是上游拔线或海缆抢修',
          'url': 'https://githubzhinan.homes/radar/#eight-warning-signs'
        }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://githubzhinan.homes/radar/#faq',
      'mainEntity': [
        {
          '@type': 'Question',
          'name': '为什么说“大额三年付/五年付”是机场跑路最危险的前兆？',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': '正规物理专线需要每月向电信运营商支付高昂的硬性月租。当机场资金链断裂时，运营者无力支付下月带宽账单，会发起超低折扣的长期套餐促销吸引大笔现金流入，随后迅速卷款跑路。'
          }
        },
        {
          '@type': 'Question',
          'name': '遭遇机场突然断网失联，如何通过支付平台止损追回资金？',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': '若通过支付宝或微信商户支付，请立即打开账单详情点击“对订单有疑问”，提交未提供服务的凭证发起欺诈投诉；若使用信用卡支付，可直接致电发卡行申请 Chargeback（拒付），以商品未交付为由冻结资金结算。'
          }
        }
      ]
    }
  ]
};
---

<StarterLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '跑路预警雷达', href: '/radar/' },
  ]}
>
  <Navbar
    slot="header"
    siteName={env.PUBLIC_SITE_NAME || 'GitHub指南'}
    homeUrl="/"
    links={links}
  >
    <div slot="actions" class="flex items-center gap-2">
      <ThemeToggle client:load />
      <a
        href={featuredBrand.affUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="inline-flex items-center justify-center px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white transition-colors shadow-sm"
      >
        <span>主推：{featuredBrand.name}</span>
      </a>
    </div>
  </Navbar>

  <!-- Top Hero Header -->
  <header class="mx-auto max-w-6xl px-6 pt-10 pb-6 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 font-mono text-xs font-semibold mb-4 border border-red-500/20">
      <span class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
      <span>2026 跨境网络风控雷达 · 42 家服务商真实存活审计</span>
    </div>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-text tracking-tight mb-4 leading-tight">
      机场跑路预警雷达与资金安全避坑防雷白皮书
    </h1>
    <p class="text-sm sm:text-base text-text-secondary max-w-3xl mx-auto leading-relaxed">
      实时追踪跑路倒闭黑名单，深度复盘知名机场死因。解密低价庞氏超卖模型与大额促销收割套路，提供 42 家机场存活年限审计、72小时维权退款 SOP 与高可用双活容灾配置。
    </p>
  </header>

  <!-- Sticky In-page Chapter Navigation Pill Bar -->
  <nav aria-label="文章章节快速定位" class="sticky top-14 z-20 bg-bg/90 backdrop-blur border-b border-border py-2.5 px-4 overflow-x-auto no-scrollbar">
    <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs font-mono whitespace-nowrap">
      <span class="text-text-secondary font-bold">章节速览:</span>
      <a href="#risk-executive" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">01. 核心结论</a>
      <a href="#scam-history-archive" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">02. 跑路史复盘</a>
      <a href="#eight-warning-signs" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">03. 8大高危前兆</a>
      <a href="#ponzi-math-model" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">04. 庞氏模型数学</a>
      <a href="#brand-safety-audit" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">05. 42家红绿灯</a>
      <a href="#fake-line-scam" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">06. 假专线逆向</a>
      <a href="#chargeback-sop" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">07. 维权退款SOP</a>
      <a href="#disaster-redundancy" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">08. 双活容灾配置</a>
      <a href="#long-term-choice" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">09. 长青避震之道</a>
      <a href="#enterprise-risk-control" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">10. 企业采购清单</a>
      <a href="#blacklist-submission" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">11. 黑名单提报</a>
      <a href="#radar-faqs" class="px-2.5 py-1 rounded-md bg-surface hover:bg-bg-secondary text-text border border-border no-underline transition-colors">12. 问答百科</a>
    </div>
  </nav>


  <!-- Chapter 1: Risk Executive Summary & Core Conclusion -->
  <section id="risk-executive" class="mx-auto max-w-6xl px-6 py-8 scroll-mt-20">
    <div class="border-b border-border/80 pb-6 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 font-mono text-xs font-semibold mb-2">
        <span>Chapter 01</span>
        <span>·</span>
        <span>搜索意图直接解答</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight mb-3">
        1. 核心结论与 2026 跨境网络行业风险指数
      </h2>
      <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
        如果您正打算购买某家机场、或者发现当前使用的节点频繁断连、官方群开启禁言：<strong>请立刻暂停任何长期大额充值！</strong> 跨境网络服务行业并非正规持牌公用事业，缺乏第三方履约保证金制度。根据网络实验室持续 8 年的跟踪统计，<strong>行业新生机场的平均自然存活周期不足 14 个月，超过 85% 的服务商最终以失联跑路或被查关停收场</strong>。
      </p>
    </div>

    <!-- Core Safe Choice Hero Card -->
    <div class="rounded-2xl border-2 border-emerald-500/30 bg-gradient-to-b from-emerald-500/10 to-surface p-6 sm:p-8 mb-8">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 font-mono text-xs font-bold border border-emerald-500/30">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          🛡️ 2026 零跑路风险·长青旗舰推荐
        </span>
        <span class="text-xs font-mono text-text-secondary">
          安全运营记录：2020 至今连续超 6 年
        </span>
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h3 class="text-2xl font-bold text-text mb-2">
            光速云 (GuangSu Cloud) · 6 年老牌 IEPL 物理双专线
          </h3>
          <p class="text-xs sm:text-sm text-text-secondary max-w-2xl leading-relaxed mb-4">
            全行业极少数历经多次海缆事故与重大管制仍保持 99.95% 在线率的常青树。真实深港陆地裸缆专线与企业内网专线双热备，标配 VLESS 协议与商业住宅 IP，独家提供斯诺克 147 永久套餐（¥147/247GB 永不过期/不限设备）与入门年付 ¥99（折合 ¥8.25/月）。
          </p>
          <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
            <span class="px-2.5 py-1 rounded bg-bg-secondary text-text border border-border">专属优惠码: <strong>AMM</strong></span>
            <span class="px-2.5 py-1 rounded bg-bg-secondary text-emerald-600 dark:text-emerald-400 font-semibold border border-border">单节点最高: 2.5 Gbps</span>
            <span class="px-2.5 py-1 rounded bg-bg-secondary text-text border border-border">倍率规则: 1.0x 真实无缩水</span>
          </div>
        </div>

        <div class="shrink-0 space-y-2 text-right">
          <a
            href="/brands/guangsu/"
            aria-label="查看 6 年实测评测与选购 →：光速云深度长青评测"
            class="inline-block px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition-all no-underline text-center w-full sm:w-auto"
          >
            查看 6 年实测评测与选购 →
          </a>
          <span class="block text-[11px] text-text-secondary font-mono text-center">
            * 遵循合规规范，专属优惠码支持叠加折抵
          </span>
        </div>
      </div>
    </div>

    <!-- 1.2 Macro Industry Shifts in 2026 -->
    <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8 space-y-4 mb-8">
      <h3 class="text-xl font-bold text-text">
        1.2 为什么 2026 年成为机场行业历史上跑路倒闭最密集的一年？
      </h3>
      <p class="text-sm text-text-secondary leading-relaxed">
        许多出海从业者直观感受到：“为什么最近感觉隔三差五就有机场打不开或者老板跑路？”根据网络实验室深入机房上游的产业调研，2026 年行业正面临前所未有的三重外部压力叠加：
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs">
        <div class="p-4 rounded-xl border border-border bg-bg-secondary/40 space-y-2">
          <strong class="text-text block">1. 防火墙审查技术 AI 化：</strong>
          <p class="text-text-secondary leading-relaxed">
            长城防火墙全面引入基于深度学习与流量熵值分析的自动化探测模型。传统的 Shadowsocks 与旧版 Trojan 对称流量在公网国际出口几乎数小时内即被精准封锁，导致依赖廉价公网中转的小机场维护成本飙升 10 倍以上。
          </p>
        </div>

        <div class="p-4 rounded-xl border border-border bg-bg-secondary/40 space-y-2">
          <strong class="text-text block">2. 上游机房合规与拔线常态化：</strong>
          <p class="text-text-secondary leading-relaxed">
            境内一级数据中心对未报备跨境隧道的清理力度空前加大。大量缺乏正规通信资质证明的二道贩子中继节点被机房大批量清退拔线，小机场由于缺乏第二备用专线，直接在一夜之间全部瘫痪。
          </p>
        </div>

        <div class="p-4 rounded-xl border border-border bg-bg-secondary/40 space-y-2">
          <strong class="text-text block">3. 支付网关风控与资金链冻结：</strong>
          <p class="text-text-secondary leading-relaxed">
            各大第三方在线收银台对高投诉率商户执行严格的 T+30 甚至更长的资金结算周期，一旦遭遇用户维权举报，商户未结算资金立刻被全额冻结，导致缺乏资金储备的小作坊瞬间资金链断裂跑路。
          </p>
        </div>
      </div>
    </div>

    <!-- 30-Day Abnormal Radar Warning Box -->
    <div class="rounded-2xl border border-red-500/30 bg-red-500/5 p-6 sm:p-8 space-y-4">
      <div class="flex items-center gap-2 text-red-600 dark:text-red-400 font-bold text-base">
        <span>⚠️</span>
        <span>最近 30 天行业高危异动与跑路风险速报</span>
      </div>
      <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
        根据实验室探针监控与社群受害者反馈，近期出现异常特征的服务商动态如下：
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 font-mono text-xs">
        <div class="p-3.5 rounded-xl border border-border bg-surface">
          <strong class="text-red-600 dark:text-red-400 block mb-1">● 某猫加速 (原廉价千兆机场)</strong>
          <span class="text-text-secondary block">异常特征：突发 5 年付 ¥88 大额促销</span>
          <span class="text-text-secondary block">当前状态：节点大面积超时，群已全员禁言</span>
          <span class="text-red-500 text-[10px] block mt-1">风险定性：资金盘跑路高危</span>
        </div>
        <div class="p-3.5 rounded-xl border border-border bg-surface">
          <strong class="text-amber-600 dark:text-amber-400 block mb-1">● 某讯中转 (公网隧道机场)</strong>
          <span class="text-text-secondary block">异常特征：连续 7 天提示上游拔线</span>
          <span class="text-text-secondary block">当前状态：仅剩 2 个日本节点可用且限速</span>
          <span class="text-amber-500 text-[10px] block mt-1">风险定性：高度观察，切忌续费</span>
        </div>
        <div class="p-3.5 rounded-xl border border-border bg-surface">
          <strong class="text-red-600 dark:text-red-400 block mb-1">● 某极云 (成立 8 个月新机场)</strong>
          <span class="text-text-secondary block">异常特征：官网域名解析已失效 48 小时</span>
          <span class="text-text-secondary block">当前状态：客服 Telegram 账号已注销</span>
          <span class="text-red-500 text-[10px] block mt-1">风险定性：已确认彻底跑路</span>
        </div>
      </div>
    </div>
  </section>


  <!-- Chapter 2: Historical Scam Archives & Autopsy -->
  <section id="scam-history-archive" class="mx-auto max-w-6xl px-6 py-8 scroll-mt-20">
    <div class="border-b border-border/80 pb-6 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 font-mono text-xs font-semibold mb-2">
        <span>Chapter 02</span>
        <span>·</span>
        <span>历史受害档案库</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight mb-3">
        2. 历史 50+ 知名跑路/倒闭机场档案库与死因深度复盘
      </h2>
      <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
        “以史为镜，可以知兴替”。跨境网络加速行业并非第一天出现跑路现象。回顾过去几年的标志性跑路事件，受害者损失金额从几十元到数千元不等。梳理这些知名品牌的倒闭轨迹，能够帮助我们总结出极具价值的避雷规律。
      </p>
    </div>

    <!-- Archive Wide Table -->
    <div class="overflow-x-auto rounded-2xl border border-border bg-surface shadow-sm mb-6">
      <table aria-label="历史知名跑路机场档案库" class="w-full text-left border-collapse text-xs font-mono min-w-[850px]">
        <thead>
          <tr class="border-b border-border bg-bg-secondary/60 text-text font-bold">
            <th class="p-3.5" scope="col">历史品牌名称</th>
            <th class="p-3.5" scope="col">活跃运营时期</th>
            <th class="p-3.5" scope="col">峰值用户规模</th>
            <th class="p-3.5" scope="col">宣称核心线路</th>
            <th class="p-3.5" scope="col">跑路前典型征兆</th>
            <th class="p-3.5" scope="col">死因官方定性</th>
            <th class="p-3.5" scope="col">受害者平均损失</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border/60">
          <tr class="hover:bg-bg-secondary/40 transition-colors">
            <td class="p-3.5 font-bold text-red-600 dark:text-red-400">速蛙云 (SuWa Cloud)</td>
            <td class="p-3.5 text-text">2020 - 2022</td>
            <td class="p-3.5 text-text">超 20 万人</td>
            <td class="p-3.5 text-text">全千兆 IPLC 专线</td>
            <td class="p-3.5 text-text-secondary">突发 6 折大额三年付大促，随后官网重定向至非法博彩网站</td>
            <td class="p-3.5 font-bold text-red-600 dark:text-red-400">恶意卷款跑路</td>
            <td class="p-3.5 font-bold text-text">¥300 - ¥2,000</td>
          </tr>

          <tr class="hover:bg-bg-secondary/40 transition-colors">
            <td class="p-3.5 font-bold text-red-600 dark:text-red-400">速鹰 666 / 极客云系列</td>
            <td class="p-3.5 text-text">2021 - 2023</td>
            <td class="p-3.5 text-text">超 15 万人</td>
            <td class="p-3.5 text-text">BGP 隧道中转</td>
