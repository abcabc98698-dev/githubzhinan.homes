---
import type { SpeedTestResult } from '@astro-v7/shared/data/brands';

export interface Props {
  brandName: string;
  speedTests: SpeedTestResult[];
  testDate?: string;
  class?: string;
}

const { brandName, speedTests, testDate = '2026-10-19', class: className = '' } = Astro.props;

const items = speedTests.length > 0 ? speedTests : [
  { node: '香港 IEPL 01', latencyMs: 22, downloadMbps: 529 },
  { node: '台湾 专线 01', latencyMs: 41, downloadMbps: 114 },
  { node: '新加坡 专线 01', latencyMs: 46, downloadMbps: 387 },
  { node: '日本 东京 01', latencyMs: 57, downloadMbps: 135 },
  { node: '美国 洛杉矶 01', latencyMs: 143, downloadMbps: 18 },
];

const maxDownload = Math.max(...items.map((i) => i.downloadMbps), 500);

function getWidthClass(mbps: number): string {
  const ratio = mbps / maxDownload;
  if (ratio >= 0.9) return 'w-full';
  if (ratio >= 0.8) return 'w-4/5';
  if (ratio >= 0.7) return 'w-3/4';
  if (ratio >= 0.6) return 'w-3/5';
  if (ratio >= 0.5) return 'w-1/2';
  if (ratio >= 0.4) return 'w-2/5';
  if (ratio >= 0.3) return 'w-1/3';
  if (ratio >= 0.2) return 'w-1/4';
  return 'w-1/6';
}
---

<div class:list={['rounded-2xl border border-border bg-[var(--color-surface)] p-6 shadow-sm font-sans', className]}>
  <!-- Terminal / Lab Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/70 pb-4 mb-5">
    <div class="flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 rounded-full bg-emerald-500 animate-pulse"></span>
      <div>
        <div class="text-base font-bold text-text tracking-tight flex items-center gap-2">
          <span>{brandName}</span>
          <span class="text-xs font-mono font-medium px-2 py-0.5 rounded bg-bg-secondary text-text-secondary border border-border">实测遥测</span>
        </div>
        <p class="text-xs text-text-secondary font-mono mt-0.5">测试环境: Clash Verge Rev | 观测周期: {testDate} 晚高峰抽样</p>
      </div>
    </div>
    <div class="text-right">
      <span class="inline-flex items-center gap-1.5 text-xs font-mono px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-semibold">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        Operational · 0% 丢包
      </span>
    </div>
  </div>

  <!-- Telemetry Nodes List -->
  <div class="space-y-4">
    {items.map((item) => {
      const isLowLatency = item.latencyMs <= 60;
      const widthClass = getWidthClass(item.downloadMbps);
      return (
        <div class="group rounded-xl border border-border/50 bg-bg-secondary/40 hover:bg-bg-secondary/80 p-3.5 transition-all duration-200">
          <div class="flex items-center justify-between text-sm mb-2 font-mono">
            <span class="font-bold text-text flex items-center gap-2">
              <span class:list={['h-2 w-2 rounded-full', isLowLatency ? 'bg-emerald-500' : 'bg-amber-500']}></span>
              {item.node}
            </span>
            <div class="flex items-center gap-4 text-xs">
              <span class="text-text-secondary">
                延迟: <strong class:list={['font-semibold', isLowLatency ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400']}>{item.latencyMs}ms</strong>
              </span>
              <span class="text-text-secondary">
                下行: <strong class="text-text font-bold text-sm">{item.downloadMbps}</strong> <span class="text-[11px]">Mbps</span>
              </span>
            </div>
          </div>
          <!-- Progress Bar (No inline style attribute) -->
          <div class="relative h-2 w-full overflow-hidden rounded-full bg-bg-secondary border border-border/40">
            <div
              class:list={[
                'h-full rounded-full transition-all duration-500',
                widthClass,
                isLowLatency ? 'bg-gradient-to-r from-emerald-500 to-teal-400' : 'bg-gradient-to-r from-amber-500 to-orange-400'
              ]}
            ></div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Footer Stats -->
  <div class="mt-5 pt-3.5 border-t border-border/70 flex flex-wrap items-center justify-between text-xs text-text-secondary font-mono">
    <span>峰值带宽: <strong class="text-text font-semibold">{Math.max(...items.map((i) => i.downloadMbps))} Mbps</strong></span>
    <span>平均延迟: <strong class="text-text font-semibold">{Math.round(items.reduce((acc, i) => acc + i.latencyMs, 0) / items.length)} ms</strong></span>
    <span class="text-[11px] opacity-75">githubzhinan.homes · 网络实验室</span>
  </div>
</div>
