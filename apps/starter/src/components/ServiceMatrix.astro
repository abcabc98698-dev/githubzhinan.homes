---
import type { UnlockMatrix } from '@astro-v7/shared/data/brands';

export interface Props {
  brandName: string;
  unlocks: UnlockMatrix;
  columns?: 2 | 3 | 4;
  class?: string;
}

const { brandName, unlocks, columns = 3, class: className = '' } = Astro.props;

interface ServiceItem {
  id: string;
  name: string;
  category: 'AI 智能服务' | '流媒体与社媒';
  status: 'supported' | 'depends' | 'unsupported';
  note: string;
  icon: string;
}

const services: ServiceItem[] = [
  {
    id: 'chatgpt',
    name: 'ChatGPT / OpenAI',
    category: 'AI 智能服务',
    status: unlocks.chatgpt,
    note: unlocks.chatgpt === 'supported' ? '原生IP支持 · GPT-4o 流畅' : '需选择部分原生节点',
    icon: '🤖'
  },
  {
    id: 'claude',
    name: 'Claude 3.5 Sonnet',
    category: 'AI 智能服务',
    status: unlocks.claude,
    note: unlocks.claude === 'supported' ? '全节点支持 · 防降级风控' : '视节点而定',
    icon: '⚡'
  },
  {
    id: 'gemini',
    name: 'Google Gemini',
    category: 'AI 智能服务',
    status: unlocks.gemini,
    note: unlocks.gemini === 'supported' ? '支持 Google Workspace' : '部分节点受地域风控',
    icon: '✨'
  },
  {
    id: 'netflix',
    name: 'Netflix (网飞)',
    category: '流媒体与社媒',
    status: unlocks.netflix,
    note: unlocks.netflix === 'supported' ? '全区原创剧 + 非自制剧' : '视节点而定',
    icon: '🍿'
  },
  {
    id: 'disney',
    name: 'Disney+ (迪士尼)',
    category: '流媒体与社媒',
    status: unlocks.disney,
    note: unlocks.disney === 'supported' ? '支持 4K UHD + 杜比全景声' : '视节点而定',
    icon: '🏰'
  },
  {
    id: 'youtube',
    name: 'YouTube Premium',
    category: '流媒体与社媒',
    status: unlocks.youtube,
    note: unlocks.youtube === 'supported' ? '4K 60FPS 极速秒开' : '正常支持',
    icon: '▶️'
  },
  {
    id: 'tiktok',
    name: 'TikTok 跨境直播',
    category: '流媒体与社媒',
    status: unlocks.tiktok,
    note: unlocks.tiktok === 'supported' ? '原生海外落地 · 社媒可用' : '建议联系客服专线',
    icon: '🎵'
  }
];

const statusStyles = {
  supported: {
    badge: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30',
    dot: 'bg-emerald-500',
    text: '解锁'
  },
  depends: {
    badge: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30',
    dot: 'bg-amber-500',
    text: '视节点'
  },
  unsupported: {
    badge: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/30',
    dot: 'bg-rose-500',
    text: '未解锁'
  }
};

const gridColsClass =
  columns === 4
    ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'
    : columns === 2
      ? 'grid-cols-1 sm:grid-cols-1 md:grid-cols-2'
      : columns === 1
        ? 'grid-cols-1'
        : 'grid-cols-1 sm:grid-cols-2 xl:grid-cols-3';
---

<div class:list={['rounded-2xl border border-border bg-[var(--color-surface)] p-6 shadow-sm font-sans', className]}>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/70 pb-4 mb-5">
    <div>
      <div class="text-base font-bold text-text tracking-tight flex items-center gap-2">
        <span>{brandName}</span>
        <span class="text-xs font-mono font-medium px-2 py-0.5 rounded bg-bg-secondary text-text-secondary border border-border">服务可用性矩阵</span>
      </div>
      <p class="text-xs text-text-secondary font-mono mt-0.5">检测基准: 现代海外 AI 与流媒体可用性探针</p>
    </div>
    <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 font-semibold">
      原生 IP 校验通过
    </span>
  </div>

  <div class:list={['grid gap-3', gridColsClass]}>
    {services.map((item) => {
      const style = statusStyles[item.status];
      return (
        <div class="flex flex-col justify-between p-3.5 rounded-xl border border-border/60 bg-bg-secondary/40 hover:bg-bg-secondary/80 transition-all duration-200 min-w-0">
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2 min-w-0">
              <span class="text-base shrink-0">{item.icon}</span>
              <span class="font-bold text-xs sm:text-sm text-text whitespace-nowrap overflow-hidden text-ellipsis">{item.name}</span>
            </div>
            <span class:list={['shrink-0 inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono font-semibold border whitespace-nowrap', style.badge]}>
              <span class:list={['h-1.5 w-1.5 rounded-full shrink-0', style.dot]}></span>
              <span>{style.text}</span>
            </span>
          </div>
          <p class="text-xs text-text-secondary font-mono leading-relaxed line-clamp-2">
            {item.note}
          </p>
        </div>
      );
    })}
  </div>

  <div class="mt-4 pt-3 border-t border-border/70 flex flex-wrap items-center justify-between gap-2 text-xs text-text-secondary font-mono">
    <span>测试出口: 香港 / 日本 / 新加坡 / 美国原生出口</span>
    <span class="text-[11px] opacity-75">检测周期: 2026-10-19 晚高峰抽样</span>
  </div>
</div>
