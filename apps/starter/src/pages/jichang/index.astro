---
import StarterLayout from '@/layouts/StarterLayout.astro';
import Navbar from '@astro-v7/shared/components/Navbar.astro';
import ThemeToggle from '@astro-v7/shared/components/ThemeToggle.svelte';
import { env } from '@/env';
import { getFeaturedBrand, getTop10Brands, BRANDS } from '@astro-v7/shared/data/brands';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import '@/styles/app.css';

const featuredBrand = getFeaturedBrand(); // 光速云
const topBrands = getTop10Brands();

const pageTitle = '2026机场推荐与网络服务选型矩阵：IEPL物理双专线实测 - GitHub指南';
const pageDescription = '精选2026优质机场推荐大全：基于独立探针全天候监控42家机场物理专线延迟、晚高峰吞吐与丢包率。涵盖光速云等第一梯队品牌实测评测，助您精准避开跑路小作坊。';

const links = [
  { href: '/', label: '首页' },
  { href: '/vpn/', label: 'VPN推荐' },
  { href: '/jichang/', label: '机场推荐' },
  { href: '/clash/', label: 'Clash教程' },
  { href: '/nodes/', label: '节点测速' },
  { href: '/tizi/', label: '梯子避坑' },
  { href: '/free/', label: '免费资源' },
  { href: '/brands/', label: '42家品牌库' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://githubzhinan.homes/jichang/#webpage',
      'url': 'https://githubzhinan.homes/jichang/',
      'name': pageTitle,
      'description': pageDescription,
      'isPartOf': { '@id': 'https://githubzhinan.homes/#website' },
      'inLanguage': 'zh-CN',
      'datePublished': '2026-10-19',
      'dateModified': '2026-10-31',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://githubzhinan.homes/jichang/#breadcrumbs',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': '首页',
          'item': 'https://githubzhinan.homes/'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': '机场推荐与选型矩阵',
          'item': 'https://githubzhinan.homes/jichang/'
        }
      ]
    },
    {
      '@type': 'ItemList',
      '@id': 'https://githubzhinan.homes/jichang/#top-airports',
      'name': '2026 年度第一梯队优质机场推荐榜单',
      'itemListElement': topBrands.slice(0, 5).map((b, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'name': `${b.name} - ${b.lineType.split('（')[0]}`,
        'url': `https://githubzhinan.homes/brands/${b.slug}/`
      }))
    }
  ]
};
---

<StarterLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <Navbar
    slot="header"
    siteName={env.PUBLIC_SITE_NAME || 'GitHub指南'}
    homeUrl="/"
    links={links}
    currentPath="/jichang/"
  >
    <ThemeToggle client:load />
  </Navbar>

  <div class="min-h-screen bg-bg text-text py-12 px-4 sm:px-6">
    <article class="mx-auto max-w-5xl">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-text-secondary font-mono">
        <a href="/" class="hover:text-text no-underline">首页</a>
        <span>/</span>
        <span class="text-text font-semibold">机场推荐与选型矩阵</span>
      </nav>

      <!-- Hero Header -->
      <header class="border-b border-border pb-8 mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-semibold mb-4 border border-emerald-500/20">
          <span>AIRPORT DIRECTORY & TELEMETRY BENCHMARK</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-text mb-4">
          2026 年度优质机场推荐榜单与专线网络选型矩阵
        </h1>
        <p class="text-text-secondary text-base sm:text-lg leading-relaxed">
          依托独立边缘探针 24/7 遥测数据，收录全网 42 家主流机场物理链路、晚高峰 RTT 延迟、单节点带宽与流媒体解锁能力，助您彻底远离断流与跑路风险。
        </p>
      </header>

      <!-- Featured Recommendation Card -->
      <section class="rounded-2xl border border-border bg-surface p-6 sm:p-8 mb-12 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold border border-emerald-500/30">
            👑 2026 年度综合旗舰推荐 · TOP 1
          </span>
          <span class="text-xs font-mono text-text-secondary">运营始于 2020 年 · 6年稳定长青</span>
        </div>

        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-border/80">
          <div>
            <h2 class="text-2xl sm:text-3xl font-black text-text tracking-tight mb-2">
              {featuredBrand.name} (GuangSu Cloud)
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed max-w-2xl">
              物理线路：<strong class="text-text">{featuredBrand.lineType}</strong>。全平台客户端兼容，具备海外原生住宅 ISP 落地节点，稳定防降级风控。
            </p>
          </div>
          <div class="text-left md:text-right shrink-0">
            <span class="block text-xs text-text-secondary font-mono">起步参考价</span>
            <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400 font-mono">{featuredBrand.minMonthlyPrice}</span>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-6 border-b border-border/80 text-xs font-mono">
          <div>
            <span class="text-text-secondary block mb-1">物理线路架构</span>
            <strong class="text-text">IEPL专线 + 内网专线</strong>
          </div>
          <div>
            <span class="text-text-secondary block mb-1">主要传输协议</span>
            <strong class="text-text">VLESS-XTLS</strong>
          </div>
          <div>
            <span class="text-text-secondary block mb-1">香港测速延迟</span>
            <strong class="text-emerald-600 dark:text-emerald-400">22 ms (0%丢包)</strong>
          </div>
          <div>
            <span class="text-text-secondary block mb-1">独家特权方案</span>
            <strong class="text-blue-600 dark:text-blue-400">致敬斯诺克 147 永久</strong>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-6">
          <a
            href={featuredBrand.affUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm no-underline shadow-md shadow-emerald-600/20"
          >
            直达光速云官网注册 ↗
          </a>
          <a
            href="/brands/guangsu/"
            class="px-5 py-3 rounded-xl border border-border bg-bg-secondary hover:bg-bg-secondary/80 text-text font-semibold text-sm no-underline"
          >
            阅读 11,500 字深度评测白皮书 →
          </a>
        </div>
      </section>

      <!-- Chapter 2: Top 10 Airports Ranking -->
      <section class="mb-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-text">
            二、 TOP 10 核心机场遥测排行榜
          </h2>
          <a href="/brands/" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 no-underline hover:underline">
            查看全部 42 家品牌档案 →
          </a>
        </div>

        <div class="overflow-x-auto rounded-xl border border-border bg-surface">
          <table aria-label="2026年 TOP 10 核心机场综合实测遥测总表" class="w-full text-left text-xs border-collapse font-mono">
            <thead>
              <tr class="border-b border-border bg-bg-secondary/60 text-text">
                <th class="p-3.5">排名</th>
                <th class="p-3.5">品牌名称</th>
                <th class="p-3.5">线路类型</th>
                <th class="p-3.5">起步价格</th>
                <th class="p-3.5">香港延迟</th>
                <th class="p-3.5">峰值下行</th>
                <th class="p-3.5 text-right">操作</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/60 text-text-secondary">
              {topBrands.map((b) => (
                <tr class="hover:bg-bg-secondary/30 transition-colors">
                  <td class="p-3.5 font-bold text-text">#{b.rank}</td>
                  <td class="p-3.5 font-bold text-text">
                    <a href={`/brands/${b.slug}/`} class="text-text hover:text-emerald-600 dark:hover:text-emerald-400 no-underline">
                      {b.name}
                    </a>
                  </td>
                  <td class="p-3.5">{b.lineType.split('（')[0]}</td>
                  <td class="p-3.5 text-emerald-600 dark:text-emerald-400 font-bold">{b.minMonthlyPrice}</td>
                  <td class="p-3.5 font-semibold text-text">{b.speedSummary.avgLatency}ms</td>
                  <td class="p-3.5">{b.speedSummary.peakDownloadMbps}Mbps</td>
                  <td class="p-3.5 text-right">
                    <a href={`/brands/${b.slug}/`} class="text-emerald-600 dark:text-emerald-400 font-semibold no-underline hover:underline" >
                      {b.name} 档案 →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Chapter 3: Selection Pillars -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4">
          三、 机场避坑与选型相关专题
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a href="/radar/" class="p-4 rounded-xl border border-border bg-surface hover:border-emerald-500/50 transition-all no-underline block">
            <span class="block text-sm font-bold text-text mb-1">🚨 跑路预警雷达</span>
            <span class="text-xs text-text-secondary leading-relaxed">50+ 倒闭机场复盘与资金安全风控模型。</span>
          </a>
          <a href="/faq/" class="p-4 rounded-xl border border-border bg-surface hover:border-emerald-500/50 transition-all no-underline block">
            <span class="block text-sm font-bold text-text mb-1">📖 疑难技术百科</span>
            <span class="text-xs text-text-secondary leading-relaxed">DNS 污染、节点超时与 TUN 模式百问百答。</span>
          </a>
          <a href="/free/" class="p-4 rounded-xl border border-border bg-surface hover:border-emerald-500/50 transition-all no-underline block">
            <span class="block text-sm font-bold text-text mb-1">🎁 免费资源合集</span>
            <span class="text-xs text-text-secondary leading-relaxed">公共订阅蜜罐逆向与 42 家合规 0 元试用。</span>
          </a>
        </div>
      </section>

      <!-- Bottom Disclosure -->
      <div class="mt-8">
        <AffiliateDisclosure />
      </div>
    </article>
  </div>
</StarterLayout>
