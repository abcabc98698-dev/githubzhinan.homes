      <!-- Protocols Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        {protocolBenchmarks.map((p) => (
          <div class="p-6 rounded-xl border border-border bg-bg-secondary/40 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-base font-bold text-text">{p.name}</h3>
