---
import StarterLayout from '@/layouts/StarterLayout.astro';
import Navbar from '@astro-v7/shared/components/Navbar.astro';
import ThemeToggle from '@astro-v7/shared/components/ThemeToggle.svelte';
import { env } from '@/env';
import '@/styles/app.css';

const pageTitle = '关于我们与网络评测实验室使命 - GitHub指南';
const pageDescription = '了解 GitHub指南 (githubzhinan.homes) 网络可观测性实验室的成立初衷、全球物理探针节点分布、客观独立评测准则、技术团队背景与商业模式透明度声明。';

const links = [
  { href: '/', label: '首页' },
  { href: '/brands/guangsu/', label: '光速云 (TOP 1)' },
  { href: '/radar/', label: '🚨 跑路雷达' },
  { href: '/observatory/', label: '⚡ 测速室' },
  { href: '/clients/', label: '💻 客户端' },
  { href: '/faq/', label: '📖 疑难百科' },
  { href: '/free/', label: '🎁 免费资源' },
  { href: '/brands/', label: '42家品牌库' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': 'https://githubzhinan.homes/about/#webpage',
      'url': 'https://githubzhinan.homes/about/',
      'name': pageTitle,
      'description': pageDescription,
      'isPartOf': { '@id': 'https://githubzhinan.homes/#website' },
      'inLanguage': 'zh-CN',
      'datePublished': '2026-10-19',
      'dateModified': '2026-10-31',
    },
    {
      '@type': 'Organization',
      '@id': 'https://githubzhinan.homes/#organization',
      'name': 'GitHub指南网络实验室',
      'url': 'https://githubzhinan.homes/',
      'logo': 'https://githubzhinan.homes/logo.svg',
      'email': 'contact@githubzhinan.homes',
      'description': '专注于跨境出海网络可观测性评测、开源工具链与开发者网络选型指南的独立技术团队。'
    }
  ]
};
---

<StarterLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <Navbar
    slot="header"
    siteName={env.PUBLIC_SITE_NAME || 'GitHub指南'}
    homeUrl="/"
    links={links}
    currentPath="/about/"
  >
    <ThemeToggle client:load />
  </Navbar>

  <div class="min-h-screen bg-bg text-text py-12 px-4 sm:px-6">
    <article class="mx-auto max-w-4xl">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-text-secondary font-mono">
        <a href="/" class="hover:text-text no-underline">首页</a>
        <span>/</span>
        <span class="text-text font-semibold">关于实验室</span>
      </nav>

      <!-- Header -->
      <header class="border-b border-border pb-8 mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-semibold mb-4 border border-emerald-500/20">
          <span>LAB PROFILE & EDITORIAL POLICY</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-text mb-4">
          关于我们：网络可观测性实验室与技术选型使命
        </h1>
        <p class="text-text-secondary text-base sm:text-lg leading-relaxed">
          摒弃信息黑箱与商业水军伪装，以独立探针数据、开源自动化监测与客观物理专线压测，为全球开发者与跨境外贸企业提供可信赖的网络选型指南。
        </p>
      </header>

      <!-- Chapter 1: Mission -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4 flex items-center gap-2">
          <span class="text-emerald-500">01.</span>
          <span>创立初衷：终结网络代理市场的“信息不对称”</span>
        </h2>
        <div class="prose prose-neutral dark:prose-invert max-w-none text-text-secondary text-sm leading-relaxed space-y-4 font-sans">
          <p>
            在跨境出海、开源技术学习与 AI 研发浪潮中，稳定的国际互联网络已成为开发者的核心生产力基础设施。然而，当前中文互联网的代理与机场评测领域充斥着严重的信息不对称：低成本公网中转伪装成昂贵的物理专线、贴牌跑路黑产平台频繁卷款、虚假的测速截图与刷单好评屡见不鲜。
          </p>
          <p>
            <strong>GitHub指南 (githubzhinan.homes) 网络评测实验室</strong>由多位资深网络架构师、DevOps 工程师与开源社区开发者联合发起。我们坚持以“客观数据说话”为唯一原则，拒绝主观情绪化推荐，通过长期、连续、多维度的物理探针网络，为用户呈现真实的网络时延、晚高峰带宽与稳定性波动。
          </p>
        </div>
      </section>

      <!-- Chapter 2: Probe Infrastructure -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4 flex items-center gap-2">
          <span class="text-emerald-500">02.</span>
          <span>全球探针网络与测试拓扑</span>
        </h2>
        <div class="rounded-2xl border border-border bg-surface p-6 mb-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-center">
            <div class="p-3 rounded-xl bg-bg-secondary/60 border border-border/60">
              <span class="block text-xl font-bold text-emerald-600 dark:text-emerald-400">42+</span>
              <span class="text-xs text-text-secondary font-mono">持续观测品牌</span>
            </div>
            <div class="p-3 rounded-xl bg-bg-secondary/60 border border-border/60">
              <span class="block text-xl font-bold text-text font-mono">24 / 7</span>
              <span class="text-xs text-text-secondary font-mono">自动化轮询探针</span>
            </div>
            <div class="p-3 rounded-xl bg-bg-secondary/60 border border-border/60">
              <span class="block text-xl font-bold text-blue-600 dark:text-blue-400 font-mono">5 大</span>
              <span class="text-xs text-text-secondary font-mono">核心出口基准</span>
            </div>
            <div class="p-3 rounded-xl bg-bg-secondary/60 border border-border/60">
              <span class="block text-xl font-bold text-amber-600 dark:text-amber-400 font-mono">0%</span>
              <span class="text-xs text-text-secondary font-mono">虚假好评容忍度</span>
            </div>
          </div>
        </div>
        <p class="text-text-secondary text-sm leading-relaxed mb-4">
          实验团队部署了多地独立边缘测试探针，包括华东、华南、华北三大骨干入口，对收录的 42 家主流网络服务商进行香港、台湾、新加坡、日本东京、美国西海岸等出口节点的往返时延 (RTT)、丢包率、单线程与多线程吞吐测试。重点采集每天 20:00 - 23:30 晚高峰国际出口拥堵时段的极限性能。
        </p>
      </section>

      <!-- Chapter 3: Editorial Guidelines -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4 flex items-center gap-2">
          <span class="text-emerald-500">03.</span>
          <span>中立评测准则与商业透明度披露</span>
        </h2>
        <div class="space-y-4 text-sm text-text-secondary leading-relaxed">
          <div class="p-4 rounded-xl border border-border/80 bg-surface">
            <h3 class="font-bold text-text text-base mb-1">1. 自费购买与匿名体验</h3>
            <p>本站实测所涉及的所有套餐与会员均由实验室经费自费购买或通过合法公开渠道接入，不接受任何厂商针对特定评测报告的“赞助定制造假”，保证评测视角与普通最终用户完全一致。</p>
          </div>
          <div class="p-4 rounded-xl border border-border/80 bg-surface">
            <h3 class="font-bold text-text text-base mb-1">2. 推广返佣 (Affiliate) 透明披露</h3>
            <p>为维持全球测试探针服务器的高昂带宽与日常运维开销，本站部分品牌注册链接包含推广返利代码（Affiliate Link）。所有此类链接均已严格遵照搜索引擎与万维网联盟规范，包裹 <code>rel="nofollow sponsored noopener"</code> 属性。使用返利代码绝不会增加您的实际购买成本，且厂商是否提供返利绝不影响其实际测速与排名的客观性。</p>
          </div>
          <div class="p-4 rounded-xl border border-border/80 bg-surface">
            <h3 class="font-bold text-text text-base mb-1">3. 严禁黑产与高危跑路平台</h3>
            <p>一旦某服务商出现跑路前兆（如超低价永久套餐倾销、大面积拔线、TG 群开启全员禁言等），实验室将第一时间在 <a href="/radar/" class="text-emerald-600 dark:text-emerald-400 font-bold underline">跑路预警雷达</a> 中拉响警报并下架相关入口。</p>
          </div>
        </div>
      </section>

      <!-- Chapter 4: Team and Contact -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-text mb-4 flex items-center gap-2">
          <span class="text-emerald-500">04.</span>
          <span>维护团队与技术联络</span>
        </h2>
        <p class="text-text-secondary text-sm leading-relaxed mb-4">
          如果您是网络协议开发者、开源客户端维护者，或发现某家收录品牌的技术参数有重大更新、节点大面积断流、遭受非对称攻击，欢迎通过以下官方渠道与实验室团队取得联系：
        </p>
        <div class="p-5 rounded-2xl border border-emerald-500/30 bg-emerald-500/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="block font-bold text-text text-sm">技术合作、测试反馈与数据勘误</span>
            <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-semibold">contact@githubzhinan.homes</span>
          </div>
          <a
            href="mailto:contact@githubzhinan.homes"
            class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs no-underline transition-colors shrink-0"
          >
            发送邮件联络
          </a>
        </div>
      </section>
    </article>
  </div>
</StarterLayout>
